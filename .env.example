# Base de données PostgreSQL
DATABASE_URL="postgresql://kagette:kagette@localhost:5432/kagette?schema=public"

# Auth.js
AUTH_SECRET="genere-avec: openssl rand -base64 33"
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > Identifiants)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe Connect (mode test — dashboard.stripe.com/test/apikeys) — laisse vide
# pour désactiver proprement le paiement (achat/connexion Stripe masqués côté UI)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mapbox (account.mapbox.com/access-tokens) — laisse vide pour voir la liste
# sans carte ; renseigne un vrai token public (commence par "pk.") pour l'activer
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Resend (resend.com/api-keys)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Kagette <bonjour@kagette.fr>"

# Stockage S3-compatible (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kagette"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
